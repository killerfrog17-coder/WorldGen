@using WorldGen.Presentation
@inject IJSRuntime JS
@implements IAsyncDisposable
<div class="atlas-backdrop" @onclick="Close">
<section class="atlas-reader" @ref="reader" role="dialog" aria-modal="true" aria-label="World atlas" @onclick:stopPropagation="true">
<header class="atlas-header"><strong>WORLD ATLAS</strong><span>Reading pauses playback · year @SimulationClockView.YearNumber(Document.Year,Document.EpochYear)</span><button disabled="@Busy" @onclick="Refresh">Refresh</button><button @onclick="Close">Close</button></header>
<div class="atlas-layout">
<nav class="atlas-directory" aria-label="Atlas directory">
<button disabled="@Busy" @onclick='()=>Navigate.InvokeAsync(new AtlasLink{Kind="world",Id=-1})'>World overview</button>
@foreach(var kind in new[]{("state","States"),("province","Provinces"),("city","Cities"),("people","Peoples"),("ethnicity","Ethnicities"),("language","Languages"),("religion","Religions"),("religious-body","Ritual bodies"),("technology","Technology"),("ruler","Rulers"),("organization","Organizations")}){<button disabled="@Busy" class="@(DirectoryKind==kind.Item1?"selected":"")" @onclick="()=>Category.InvokeAsync(kind.Item1)">@kind.Item2</button>}
<input aria-label="Search atlas names" placeholder="Search names" @bind="search" @bind:event="oninput"/>
<label><input type="checkbox" @bind="past"/> Include historical records</label>
@{var matching=Directory.Where(l=>(past||!l.Historical)&&l.Name.Contains(search,StringComparison.OrdinalIgnoreCase)).ToArray();string filter=search+"|"+past+"|"+DirectoryKind;if(filter!=directoryFilter){directoryFilter=filter;directoryPage=0;}int pages=Math.Max(1,(matching.Length+199)/200);directoryPage=Math.Min(directoryPage,pages-1);}
@if(pages>1){<div class="atlas-directory-paging"><button disabled="@(directoryPage==0)" aria-label="Previous directory page" @onclick="()=>directoryPage--">‹</button><span>@(directoryPage+1) / @pages</span><button disabled="@(directoryPage==pages-1)" aria-label="Next directory page" @onclick="()=>directoryPage++">›</button></div>}
<div class="atlas-directory-list">@foreach(var link in matching.Skip(directoryPage*200).Take(200)){<button data-kind="@link.Kind" data-id="@link.Id" disabled="@Busy" title="@(link.Context.Length>0?link.Context+" · "+link.Detail:link.Detail)" @onclick="()=>Navigate.InvokeAsync(link)">@link.Name@if(repeatedNames.Contains(link.Name)&&link.Context.Length>0){<small>@link.Context</small>}</button>}@if(matching.Length==0){<p>No matching records.</p>}</div>
</nav>
<article class="atlas-article" data-kind="@Document.Kind" data-id="@Document.Id" @key="Document">
<div class="atlas-actions"><button disabled="@(Busy||!CanBack)" @onclick="Back">Back</button><button @onclick="CopyArticle">Copy article</button><button disabled="@(Busy||Document.Cell<0)" @onclick="()=>Map.InvokeAsync(Document.Cell)">Show on map</button></div>
@if(copyNotice.Length>0){<p role="status" class="atlas-copy-notice">@copyNotice</p>}
@if(Busy){<p role="status" class="atlas-loading">Opening record…</p>}
<h1>@Document.Title</h1><p class="atlas-subtitle">@Document.Subtitle</p>
@{var chapters=new[]{"Overview"}.Concat(Document.Sections.Select(s=>s.Title)).ToArray();var group=AtlasNavigation.Group(section);}
<div class="atlas-chapters" role="navigation" aria-label="Article chapters">@foreach(var chapter in AtlasNavigation.Groups.Where(g=>chapters.Any(t=>AtlasNavigation.Group(t)==g))){<button class="@(chapter==group?"selected":"")" @onclick="()=>SelectSection(chapters.First(t=>AtlasNavigation.Group(t)==chapter))">@chapter</button>}</div>
<div class="atlas-contents" role="navigation" aria-label="Article sections">@foreach(var title in chapters.Where(t=>t!="Overview"&&AtlasNavigation.Group(t)==group)){<button disabled="@Busy" class="@(section==title?"selected":"")" aria-current="@(section==title?"page":null)" @onclick="()=>SelectSection(title)">@title</button>}</div>
<div class="atlas-reading" @key="section">
@if(section=="Overview"){
<p class="atlas-lead">@Document.Introduction</p>
<div class="atlas-fact-tiles">@foreach(var fact in Document.Facts){<div><small>@fact.Label</small><strong>@fact.Value</strong></div>}</div>
var visual=HistoryAtlas.OverviewVisual(Document);
@if(visual!=null){<section class="atlas-overview-chart"><h2>@visual.Title</h2>@if(visual.Diagram){@((MarkupString)AtlasDiagram.DiplomaticSvg(Document,visual))}else if(visual.Technical.Length>0){@foreach(var project in visual.Technical){<label class="overview-project">@project.Name · level @project.Level → @(project.Level+1)<progress value="@project.ResearchPermille" max="1000"></progress><small>@project.Source · @((project.AllocationBasisPoints/100.0).ToString("0.#"))% of research effort</small></label>}}else{var maximum=visual.Unit=="/ 1,000"?1000:Math.Max(1,visual.Links.Max(l=>l.Value));@foreach(var link in visual.Links){<div class="atlas-link-row">@if(link.Kind.Length>0){<button @onclick="()=>Navigate.InvokeAsync(link)">@link.Name</button>}else{<strong>@link.Name</strong>}<span>@link.Detail</span><progress aria-label="@link.Name" value="@link.Value" max="@maximum"></progress></div>}}</section>}
<HabitatPortraitCard Portrait="@Document.Habitat"/>
<p>Explore the sections above for connections, livelihoods, institutions, and recorded events. Names in the article open related entries.</p>
}else{
var item=Document.Sections.FirstOrDefault(s=>s.Title==section);
@if(item!=null){
<h2>@item.Title</h2>@if(item.Text.Length>0){<p>@item.Text</p>}
@if(item.Facts.Length>0){<dl>@foreach(var fact in item.Facts){<dt>@fact.Label</dt><dd>@if(fact.Swatch.Length>0){<span class="appearance-swatch" style="background-color:@fact.Swatch" aria-hidden="true"></span>}@fact.Value</dd>}</dl>}
@if(item.Technical.Length>0){<div class="technical-grid">@foreach(var project in item.Technical){<section class="technical-card"><h3>@project.Name <small>Level @project.Level</small></h3><p>@project.Source</p>@if(project.AllocationBasisPoints>0){<label>Research share @((project.AllocationBasisPoints/100.0).ToString("0.0"))%<progress value="@project.AllocationBasisPoints" max="10000"></progress></label>}@if(project.AtCeiling){<p>At current model ceiling</p>}else{<label>Next level @((project.ResearchPermille/10.0).ToString("0.0"))%<progress value="@project.ResearchPermille" max="1000"></progress></label>}<label>Practical deployment @((project.DeploymentPermille/10.0).ToString("0.0"))%<progress value="@project.DeploymentPermille" max="1000"></progress></label>@if(project.Prerequisites.Length>0){<details><summary>Research prerequisites</summary><p>@project.Prerequisites</p></details>}</section>}</div>}
@if(item.Diagram){@((MarkupString)AtlasDiagram.DiplomaticSvg(Document,item))}
var maximum=item.Unit=="/ 1,000"?1000:Math.Max(1,item.Links.Select(l=>l.Value).DefaultIfEmpty(1).Max());
<div class="@(item.CompactGrid?"atlas-resource-grid":"atlas-links")">@foreach(var link in item.Links){<div class="atlas-link-row">@if(link.Kind.Length>0){<button disabled="@Busy" title="@link.Context" @onclick="()=>Navigate.InvokeAsync(link)">@link.Name</button>}else{<strong>@link.Name</strong>}<span>@link.Detail</span>@if(item.Bars){<progress aria-label="@link.Name" style="accent-color:@ChartColor(link)" value="@link.Value" max="@maximum"></progress>}</div>}</div>
var records=item.Timeline;
@if(item.Title=="Recorded history"&&TimelinePage!=null){
records=TimelinePage.Records;
<div class="atlas-history-controls"><label><input type="checkbox" disabled="@Busy" checked="@TimelinePage.IncludeRoutine" @onchange="e=>Routine.InvokeAsync((bool)e.Value)"/> Include routine records</label><button disabled="@(Busy||TimelinePage.Offset==0)" @onclick="()=>Page.InvokeAsync(TimelinePage.Offset-40)">Newer</button><button disabled="@(Busy||TimelinePage.Offset+TimelinePage.Records.Length>=TimelinePage.Total)" @onclick="()=>Page.InvokeAsync(TimelinePage.Offset+40)">Older</button></div>
<p class="atlas-record-count">@(TimelinePage.Total==0?"No matching records.":$"Records {TimelinePage.Offset+1:N0}–{TimelinePage.Offset+TimelinePage.Records.Length:N0} of {TimelinePage.Total:N0}")</p>
}
<div class="atlas-timeline">@foreach(var point in records){<div><small>@point.Label</small><p>@point.Value</p><div class="atlas-event-links">@foreach(var related in point.Related.Where(l=>l.Kind!=Document.Kind||l.Id!=Document.Id)){<button title="@related.Context" disabled="@Busy" @onclick="()=>Navigate.InvokeAsync(related)">@related.Name</button>}</div></div>}</div>
@if(item.Links.Length==0&&item.Facts.Length==0&&item.Timeline.Length==0&&item.Text.Length==0&&item.Technical.Length==0){<p>No records yet.</p>}
}}
<p class="atlas-note">@Document.Note</p>
</div>
</article></div></section></div>
@code {
    [Parameter] public AtlasDocument Document{get;set;}=new();
    [Parameter] public AtlasLink[] Directory{get;set;}=Array.Empty<AtlasLink>();
    [Parameter] public string DirectoryKind{get;set;}="state";
    [Parameter] public bool CanBack{get;set;}
    [Parameter] public bool Busy{get;set;}
    [Parameter] public AtlasTimeline TimelinePage{get;set;}
    [Parameter] public EventCallback<int> Page{get;set;}
    [Parameter] public EventCallback<bool> Routine{get;set;}
    [Parameter] public EventCallback<AtlasLink> Navigate{get;set;}
    [Parameter] public EventCallback<string> Category{get;set;}
    [Parameter] public EventCallback<int> Map{get;set;}
    [Parameter] public EventCallback Back{get;set;}
    [Parameter] public EventCallback Close{get;set;}
    [Parameter] public EventCallback Refresh{get;set;}
    string section="Overview",search="",copyNotice="",directoryFilter="";bool past;int directoryPage;AtlasDocument previous;AtlasLink[] priorDirectory;HashSet<string> repeatedNames=new();
    ElementReference reader;IJSObjectReference focusModule;bool disposed;
    string ChartColor(AtlasLink link)=>link.Kind=="state"||link.Kind=="people"||link.Kind=="religion"?SocietyView.ColorHex(link.Id):"#baa475";
    async Task SelectSection(string name){section=name;if(name=="Recorded history")await Page.InvokeAsync(0);}
    async Task CopyArticle(){try{await JS.InvokeVoidAsync("navigator.clipboard.writeText",HistoryAtlas.PlainText(Document,TimelinePage));copyNotice="Article copied.";}catch(JSException){copyNotice="The browser blocked clipboard access. You can still select and copy the text.";}}
    protected override void OnParametersSet(){if(!ReferenceEquals(previous,Document)){previous=Document;section="Overview";copyNotice="";}if(!ReferenceEquals(priorDirectory,Directory)){priorDirectory=Directory;directoryPage=0;repeatedNames=Directory.GroupBy(x=>x.Name).Where(g=>g.Count()>1).Select(g=>g.Key).ToHashSet();}}
    protected override async Task OnAfterRenderAsync(bool first){if(first){var loaded=await JS.InvokeAsync<IJSObjectReference>("import","./atlas-focus.js");if(disposed){await loaded.DisposeAsync();return;}focusModule=loaded;await focusModule.InvokeVoidAsync("activate",reader);}}
    public async ValueTask DisposeAsync(){disposed=true;if(focusModule!=null){try{await focusModule.InvokeVoidAsync("deactivate");await focusModule.DisposeAsync();}catch(JSDisconnectedException){}}}
}
