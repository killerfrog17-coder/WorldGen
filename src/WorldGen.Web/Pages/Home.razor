    async Task LoadWorld(InputFileChangeEventArgs e){screen="Simulation";try{importRollbackRecipe=recipe.Clone();busy=true;var file=e.File;if(Path.GetExtension(file.Name).Equals(".world",StringComparison.OrdinalIgnoreCase)){using var input=file.OpenReadStream(WorldFile.MaximumFileBytes);using var memory=new MemoryStream();await input.CopyToAsync(memory);await module.InvokeVoidAsync("loadWorldFile",Convert.ToBase64String(memory.ToArray()));}else{using var reader=new StreamReader(file.OpenReadStream(250000000));await module.InvokeVoidAsync("loadWorld",await reader.ReadToEndAsync());}}catch(Exception ex){error=ex.Message;busy=false;}}
    async Task LoadRecipe(InputFileChangeEventArgs e){try{using var reader=new StreamReader(e.File.OpenReadStream(1000000));recipe=WorldJson.ReadRecipe(await reader.ReadToEndAsync());dirty=true;error="";}catch(Exception ex){error=ex.Message;}}
    bool Available(Layer l){if(world==null)return false;if(l==Layer.Simulation)return world.Stages.Any(s=>s.Name=="biogeography");if(l==Layer.Microplates||l==Layer.Continents||l==Layer.Crust)return true;if(EcologyView.IsLayer(l))return world.Stages.Any(s=>s.Name=="biogeography");if(l==Layer.Climate||l==Layer.Satellite||l>=Layer.TemperatureSummer&&l<=Layer.OceanCurrentsWinter||l>=Layer.TemperatureSpring&&l<=Layer.PrecipitationAutumn)return world.Stages.Any(s=>s.Name=="climate");if(l>=Layer.WaterBodies&&l<=Layer.ContributingArea)return world.Stages.Any(s=>s.Name=="hydrology");return world.Stages.Any(s=>s.Name=="erosion");}
