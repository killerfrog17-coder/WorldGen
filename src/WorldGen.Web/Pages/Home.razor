@page "/"
@using System.Reflection
@using System.Globalization
@using System.Security.Cryptography
@using WorldGen.Core
@using WorldGen.Serialization
@using WorldGen.Presentation
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>WorldGen · Planet laboratory</PageTitle>
<header class="topbar"><div class="brand"><span class="brand-orbit">◉</span> WORLDGEN <span class="edition">PLANET LABORATORY / 01</span></div><span class="status-dot">●</span><span class="top-status">@(busy ? "Generating in worker" : world == null ? "Ready to explore" : "World ready")</span></header>
<main class="workspace">
    <aside class="controls">
        <div class="panel-heading"><span class="eyebrow">YOUR NEXT WORLD</span><h1>Shape a planet.</h1><p>Tectonic terrain, from plate to planet.</p></div>
        <label class="preset-label">Starting recipe<select aria-label="Preset" @onchange="Preset"><option>Orogen defaults</option><option>Preview</option><option>Ocean world</option><option>Continental</option><option>Glacial</option><option>500 plates</option></select></label>
        @foreach (var group in Recipe.Settings.GroupBy(f => f.GetCustomAttribute<SettingAttribute>().Group))
        {
            <details class="settings-group" open="@(group.Key == "World")"><summary><span>@group.Key</span><span class="group-count">@group.Count().ToString("00")</span></summary>
                @foreach (var field in group)
                {
                    var meta = field.GetCustomAttribute<SettingAttribute>();
                    <label class="setting"><span>@meta.Label</span><span class="setting-control"><input aria-label="@meta.Label" type="number" min="@Invariant(meta.Min)" max="@Invariant(meta.Max)" step="@Invariant(meta.Step)" value="@Convert.ToString(field.GetValue(recipe), CultureInfo.InvariantCulture)" @onchange="e => Update(field,e)" />@if(field.Name == nameof(Recipe.Seed)){<button class="seed-roll" type="button" disabled="@busy" title="Generate a random seed" @onclick="RollSeed">Roll</button>}</span></label>
                }
            </details>
        }
        <div class="version">Recipe v@(recipe.SchemaVersion) · @recipe.AlgorithmVersion</div>
        <div class="generation-actions"><button class="primary" disabled="@busy" @onclick="Generate">@(world == null ? "Generate world" : "Regenerate / reapply") <span>↗</span></button>@if (busy){<button @onclick="Cancel">Cancel</button>}</div>
        <div class="file-actions"><button @onclick="SaveRecipe">Save recipe</button><label class="file-button">Load recipe<InputFile OnChange="LoadRecipe" accept=".json" /></label></div>
        @if(dirty && world != null){<p class="notice">Settings changed. Regenerate to apply.</p>}
        @if(error.Length > 0){<p class="error" role="alert">@error</p>}
    </aside>
    <section class="observatory">
        <div class="view-toolbar"><div><span class="eyebrow">SURFACE OBSERVATORY</span><h2>@LayerName(layer)</h2></div><label class="layer-picker">Inspection layer<select disabled="@busy" aria-label="Diagnostic layer" value="@layer" @onchange="ChangeLayer">@foreach(var l in GlobeView.VisibleLayers){<option value="@l" data-layer="@((int)l)">@LayerName(l)</option>}</select></label></div>
        <div class="map-controls">
            <div class="map-tabs">@foreach(var main in new[]{Layer.Terrain,Layer.Satellite,Layer.Climate,Layer.Heightmap}){<button disabled="@busy" class="@(layer==main?"selected":"")" @onclick="()=>SelectLayer(main)">@main</button>}</div>
            <label>View <select disabled="@busy" aria-label="View" value="@projection" @onchange="ChangeProjection"><option>Globe</option><option>Map</option></select></label>
            @if(projection==Projection.Map){<label>Center longitude @centerLongitude° <input aria-label="Center longitude" type="range" min="-180" max="180" step="1" value="@centerLongitude" @oninput="ChangeLongitude" /></label>}
            <label><input disabled="@busy" aria-label="Wireframe" type="checkbox" @bind="wireframe" @bind:after="RefreshView" /> Wireframe</label>
            <label><input disabled="@busy" aria-label="Show plates" type="checkbox" @bind="showPlates" @bind:after="RefreshView" /> Show plates</label>
            <label>Grid <select disabled="@busy" aria-label="Grid spacing" @bind="gridSpacing" @bind:after="RefreshView"><option value="0">Off</option><option value="15">15 degrees</option><option value="30">30 degrees</option></select></label>
            <button @onclick="Fullscreen">Fullscreen</button>
            <span class="view-legend">@(layer==Layer.Heightmap?"Black −5,000 m · White +6,000 m":layer==Layer.Climate?"Köppen classification · inspect a cell for its class":"")</span>
        </div>
        <div class="globe-area"><canvas id="globe" aria-label="Generated planet globe or map" tabindex="0"></canvas>
            @if(world == null){<div class="empty-orbit"><span>◌</span><p>@(busy?"Constructing your world…":"A world of possibilities.")</p></div>}
            <div class="globe-caption"><span class="tiny-cross">+</span> SPHERE-NATIVE / @((world?.CellCount ?? 0).ToString("N0")) CELLS</div>
            <div class="interaction-hint">Drag to @(projection==Projection.Map?"pan":"orbit") · scroll to zoom · click to inspect</div>
            @if(busy){<div class="progress-card"><div><span>@progressStage</span><strong>@percent%</strong></div><progress value="@percent" max="100"></progress></div>}
        </div>
        <div class="metrics-strip"><div><span>LAND COVERAGE</span><strong>@MetricText("land_fraction",true)</strong></div><div><span>LANDMASSES</span><strong>@MetricText("landmass_count")</strong></div><div><span>SUPERPLATES</span><strong>@MetricText("superplates")</strong></div><div><span>HIGHEST SUMMIT</span><strong>@MetricText("max_elevation") <small>m</small></strong></div></div>
        <div class="below-globe"><section class="inspection"><span class="eyebrow">SURFACE SAMPLE</span><pre>@inspection</pre></section><section class="export"><span class="eyebrow">TAKE YOUR WORLD WITH YOU</span><p>Physical heights and the complete recipe.</p><button disabled="@(world == null)" @onclick="ExportWorld">Export result ↗</button><button disabled="@(world == null)" @onclick="ExportHeight">Export heightmap</button><button disabled="@(world == null)" @onclick="ExportCsv">Cell CSV</button></section></div>
        @if(world != null)
        {
            <details class="diagnostics"><summary>Generation report · @world.Stages.Last().Hash.Substring(0,16)</summary>
                @foreach(var warning in world.Warnings){<p class="notice">@warning</p>}
                <div class="stage-hashes">@foreach(var s in world.Stages){<div><span>@s.Name</span><code>@s.Hash</code></div>}</div>
                <table><tbody>@foreach(var m in world.Metrics){<tr><td>@m.Name.Replace('_',' ')</td><td>@m.Value.ToString("N3") @m.Unit</td></tr>}</tbody></table>
            </details>
        }
    </section>
</main>
<footer>WORLDGEN <span>A deterministic world, one recipe at a time.</span><span>GEOLOGY → TERRAIN → CLIMATE</span></footer>

@code {
    Recipe recipe=new Recipe();WorldSummary world;Layer layer=Layer.Terrain;Projection projection;int centerLongitude;int seaLevel,percent;bool busy,dirty,wireframe,showPlates;int gridSpacing=30;string error="",progressStage="",inspection="Select a cell to inspect its terrain and climate.";
    IJSObjectReference module;DotNetObjectReference<Home> callback;
    static string Invariant(double d)=>d.ToString(CultureInfo.InvariantCulture);
    static string LayerName(Layer l)=>GlobeView.LayerName(l);
    protected override async Task OnAfterRenderAsync(bool first){if(first){try{module=await JS.InvokeAsync<IJSObjectReference>("import","./globe.js");callback=DotNetObjectReference.Create(this);await module.InvokeVoidAsync("init",callback);await Generate();}catch(Exception ex){error=ex.Message;StateHasChanged();}}}
    async Task Update(FieldInfo f,ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),NumberStyles.Float,CultureInfo.InvariantCulture,out double v)){f.SetValue(recipe,f.FieldType==typeof(int)?(object)(int)v:v);if(f.GetCustomAttribute<DisplaySettingAttribute>()!=null)await RefreshView();else dirty=true;}}
    void RollSeed(){recipe.Seed=RandomNumberGenerator.GetInt32(0,1<<24);dirty=true;error="";}
    void Preset(ChangeEventArgs e){int seed=recipe.Seed;recipe=Recipe.Preset(e.Value?.ToString()??"Preview");recipe.Seed=seed;dirty=true;}
    async Task Generate(){try{recipe.Validate();error="";busy=true;percent=0;progressStage="Starting .NET worker";await module.InvokeVoidAsync("generate",WorldJson.Write(recipe));}catch(Exception ex){error=ex.Message;busy=false;}}
    async Task Cancel(){await module.InvokeVoidAsync("cancel");busy=false;progressStage="Cancelled";}
    [JSInvokable] public Task Progress(string stage,int value){progressStage=stage;percent=value;StateHasChanged();return Task.CompletedTask;}
    [JSInvokable] public async Task Complete(string json){try{world=WorldJson.Read<WorldSummary>(json);dirty=StateHash.Compute(recipe)!=StateHash.Compute(world.Recipe);await Draw();}catch(Exception ex){error=ex.Message;busy=false;}StateHasChanged();}
    [JSInvokable] public Task Restore(string json){world=string.IsNullOrEmpty(json)?null:WorldJson.Read<WorldSummary>(json);busy=false;dirty=world!=null&&StateHash.Compute(recipe)!=StateHash.Compute(world.Recipe);StateHasChanged();return Task.CompletedTask;}
    [JSInvokable] public Task RestoreView(string json){var v=WorldJson.Read<ViewOptions>(json);projection=v.Projection;layer=v.Layer;wireframe=v.Wireframe;showPlates=v.ShowPlates;gridSpacing=v.GridSpacing;StateHasChanged();return Task.CompletedTask;}
    [JSInvokable] public Task Failed(string message){error=message;busy=false;StateHasChanged();return Task.CompletedTask;}
    [JSInvokable] public async Task Pick(int cell){if(world!=null)await module.InvokeVoidAsync("pickCell",cell);}
    [JSInvokable] public Task Inspection(string text){inspection=text;StateHasChanged();return Task.CompletedTask;}
    async Task Draw(){if(world!=null){busy=true;percent=80;progressStage="Preparing view";StateHasChanged();try{await module.InvokeVoidAsync("view",WorldJson.Write(new ViewOptions{Projection=projection,Layer=layer,Wireframe=wireframe,ShowPlates=showPlates,GridSpacing=gridSpacing}));}finally{busy=false;StateHasChanged();}}}
    async Task RefreshView(){try{await Draw();error="";}catch(Exception ex){error=ex.Message;}}
    async Task SelectLayer(Layer value){layer=value;await RefreshView();}
    async Task ChangeProjection(ChangeEventArgs e){projection=Enum.Parse<Projection>(e.Value.ToString());await RefreshView();}
    async Task ChangeLongitude(ChangeEventArgs e){centerLongitude=int.Parse(e.Value.ToString());await module.InvokeVoidAsync("longitude",centerLongitude);}
    async Task ChangeLayer(ChangeEventArgs e){layer=Enum.Parse<Layer>(e.Value.ToString());await Draw();}
    async Task ChangeSea(ChangeEventArgs e){seaLevel=int.Parse(e.Value.ToString());await Draw();}
    string MetricText(string name,bool fraction=false){var m=world?.Metrics.FirstOrDefault(m=>m.Name==name);return m==null?"—":fraction?(m.Value*100).ToString("F1")+"%":m.Value.ToString("N0");}
    async Task Download(string name,string text)=>await module.InvokeVoidAsync("download",name,text,"application/json");
    async Task SaveRecipe()=>await Download("worldgen.recipe.json",WorldJson.Write(recipe));
    async Task LoadRecipe(InputFileChangeEventArgs e){try{using var reader=new StreamReader(e.File.OpenReadStream(1000000));recipe=WorldJson.ReadRecipe(await reader.ReadToEndAsync());dirty=true;error="";}catch(Exception ex){error=ex.Message;}}
    async Task Fullscreen()=>await module.InvokeVoidAsync("fullscreen");
    async Task ExportWorld()=>await module.InvokeVoidAsync("exportWorld","result");
    async Task ExportCsv()=>await module.InvokeVoidAsync("exportWorld","csv");
    async Task ExportHeight()=>await module.InvokeVoidAsync("exportWorld","heightmap");
    public async ValueTask DisposeAsync(){if(module!=null){await module.InvokeVoidAsync("dispose");await module.DisposeAsync();}callback?.Dispose();}
}
