@using WorldGen.Presentation
@using System.Globalization
<label class="setup-number">@(Caption??Label)<input aria-label="@Label" type="number" min="@Min" max="@Max" step="@Step" value="@Value.ToString(CultureInfo.InvariantCulture)" @onchange="Typed"/></label>
<input class="number-slider" aria-label="@(Label+" slider")" type="range" min="0" max="1" step="0.0001" value="@Position.ToString(CultureInfo.InvariantCulture)" @oninput="Slide"/>
@code{
    [Parameter] public string Label{get;set;}="";
    [Parameter] public string Caption{get;set;}
    [Parameter] public double Min{get;set;}
    [Parameter] public double Max{get;set;}=1;
    [Parameter] public double Step{get;set;}=.01;
    [Parameter] public double Value{get;set;}
    [Parameter] public bool Percentage{get;set;}
    [Parameter] public bool Integer{get;set;}
    [Parameter] public EventCallback<double> ValueChanged{get;set;}
    double Position=>Percentage?PercentageControl.Position(Value):WorldSetup.Position(Value,Min,Max);
    async Task Typed(ChangeEventArgs e){if(double.TryParse(e.Value?.ToString(),NumberStyles.Float,CultureInfo.InvariantCulture,out double v)&&double.IsFinite(v))await ValueChanged.InvokeAsync(Math.Clamp(WorldSetup.Round(v,Integer||Step>=1),Min,Max));}
    async Task Slide(ChangeEventArgs e){double p=double.Parse(e.Value!.ToString()!,CultureInfo.InvariantCulture);double v=Percentage?PercentageControl.Value(p):WorldSetup.Value(p,Min,Max);await ValueChanged.InvokeAsync(Math.Clamp(WorldSetup.Round(v,Integer||Step>=1),Min,Max));}
}
