#pragma kernel ClimateCells
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Color.hlsl"
struct CellClimate { float4 temperature; float4 rain; float4 geo; float4 mask; };
StructuredBuffer<CellClimate> _Cells;
StructuredBuffer<float4> _ClimateColors;
Texture2D<float4> _BaseColors;
RWTexture2D<float4> _Output;
int _Count, _Layer, _Linear;
float _Year0,_Year1,_Ice0,_Ice1,_TimeBlend;

float monsoon(float sineLat,float access,float year,float ice)
{
    float latitude=abs(asin(clamp(sineLat,-1,1))*57.2957795),age=200000-year;
    float insolation=.5+.5*cos((age-8000)/23000*6.283185307+(sineLat<0?3.141592654:0));
    float summer=saturate((insolation-.35)/.65),belt=10+13*insolation;
    return (900*summer*exp(-pow((latitude-belt)/9,2))*(1-.65*ice)+220*insolation*exp(-pow((latitude-31)/6,2))*(1-.5*ice))*access;
}
int classification(float4 temperature,float4 rain,bool northern)
{
    float annual=0,mean=0,hot=-100,cold=100,dry=1e20;
    float summer=0,sDry=1e20,wDry=1e20,sWet=0,wWet=0;int warm=0;
    float halfA=2*temperature.x+3*temperature.y+temperature.z,halfB=temperature.x+2*temperature.z+3*temperature.w;
    bool northernWarm=halfA==halfB?northern:halfA>halfB;
    [unroll] for(int m=0;m<12;m++)
    {
        float t=temperature[m/3],p=max(0,rain[m/3]);bool localSummer=m>=1&&m<=6;if(!northernWarm)localSummer=!localSummer;
        annual+=p;mean+=t/12;hot=max(hot,t);cold=min(cold,t);dry=min(dry,p);if(t>10)warm++;
        if(localSummer){summer+=p;sDry=min(sDry,p);sWet=max(sWet,p);}else{wDry=min(wDry,p);wWet=max(wWet,p);}
    }
    float share=annual>0?summer/annual:.5,threshold=max(0,20*mean+(share>.7?280:share<.3?0:140));
    if(annual<threshold*.5)return mean>=18?4:5;
    if(annual<threshold)return mean>=18?6:7;
    if(hot<=0)return 30;if(hot<=10)return 29;
    if(cold>=18)return dry>=60?1:dry>=100-annual/25?2:3;
    bool ds=sDry<wWet/3&&sDry<40,dw=wDry<sWet/10;if(ds&&dw){ds=summer<annual-summer;dw=!ds;}
    int heat=hot>=22?0:warm>=4?1:2;
    if(cold>0)return (ds?8:dw?11:14)+heat;
    if(cold< -38&&heat==2)heat=3;
    return (ds?17:dw?21:25)+heat;
}
float3 satellite(int kind,float height,float hot)
{
    float3 c=kind==1?float3(.08,.23,.09):kind==2?float3(.17,.32,.12):kind==3?float3(.48,.49,.22):
        kind==4||kind==5?float3(.76,.64,.43):kind==6||kind==7?float3(.58,.56,.31):
        kind==29?float3(.46,.48,.4):kind==30?float3(.92,.95,.94):kind>=17?float3(.19,.3,.22):float3(.28,.4,.18);
    c=lerp(c,float3(.52,.5,.46),saturate((height-1800)/2200)*.65);
    return lerp(c,float3(.94,.96,.97),saturate((3-hot)/8));
}
float3 at(CellClimate cell,float year,float ice)
{
    float lat=cell.geo.x,height=cell.geo.y;
    float delta=-ice*(2.5+8*lat*lat+max(0,height-2000)*.0003),moisture=max(.45,1-ice*cell.geo.z);
    float4 temperature=cell.temperature+delta;
    float added=monsoon(lat,cell.geo.w,year,ice),winterShare=saturate((abs(asin(lat)*57.2957795)-23)/15)*.7;
    int summer=lat<0?3:1,winter=(summer+2)%4;float4 rain;
    [unroll]for(int q=0;q<4;q++)rain[q]=max(0,cell.rain[q]*moisture+added*(.08+(q==summer?.68*(1-winterShare):0)+(q==winter?.68*winterShare:0))/3);
    int kind=classification(temperature,rain,lat>=0);
    if(_Layer==0)return _ClimateColors[kind].rgb;
    if(_Layer==1)return satellite(kind,height,max(max(temperature.x,temperature.y),max(temperature.z,temperature.w)));
    if(_Layer>=2&&_Layer<6)return lerp(float3(.2,.25,.7),float3(.95,.35,.12),saturate((temperature[_Layer-2]*10+450)/900));
    return lerp(float3(.6,.4,.2),float3(.12,.58,.74),saturate(rain[_Layer-6]*3/900));
}
[numthreads(128,1,1)]
void ClimateCells(uint id:SV_DispatchThreadID)
{
    if(id>=_Count)return;uint2 uv=uint2(id%2048,id/2048);CellClimate cell=_Cells[id];
    if(cell.mask.x<.5){_Output[uv]=_BaseColors[uv];return;}
    float3 color=cell.mask.x>1.5?float3(.055,.34,.68):lerp(at(cell,_Year0,_Ice0),at(cell,_Year1,_Ice1),_TimeBlend);
    if(_Linear!=0)color=SRGBToLinear(color);_Output[uv]=float4(color,1);
}
