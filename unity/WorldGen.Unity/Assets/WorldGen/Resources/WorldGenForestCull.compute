#pragma kernel Cull
struct Root {float3 position;float width;float height;float yaw;float slopeX;float slopeZ;float3 tint;uint field;};
StructuredBuffer<Root> _Roots;
StructuredBuffer<int> _Fields;
StructuredBuffer<int4> _Tiles;
AppendStructuredBuffer<uint> _Visible;
float4 _Planes[6],_Chart,_Ranges;float3 _Eye;uint _RootCount;
uint Mix(uint x){x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;return x^(x>>16);}
bool Present(int x,int z,int level)
{
    uint mask=(uint)_Ranges.w,slot=Mix((uint)x*73856093u^(uint)z*19349663u^(uint)level*83492791u)&mask;
    [loop]for(uint attempt=0;attempt<=mask;attempt++)
    {int4 item=_Tiles[slot];if(item.w==0)return false;if(item.x==x&&item.y==z&&item.z==level)return true;slot=(slot+1)&mask;}
    return false;
}
[numthreads(64,1,1)]
void Cull(uint3 tid:SV_DispatchThreadID)
{
    uint at=tid.x;if(at>=_RootCount)return;Root root=_Roots[at];if(root.height<=0||_Fields[root.field&65535u]==0)return;
    float3 p=root.position-_Chart.xyz+float3(0,root.height*.5,0);
    float radius=max(root.width,root.height)*1.8+root.width*length(float2(root.slopeX,root.slopeZ))*1.5;
    float distance=length(p-_Eye);if(distance+radius<_Ranges.x||distance-radius>_Ranges.z)return;
    [unroll]for(int plane=0;plane<6;plane++)if(dot(_Planes[plane].xyz,p)+_Planes[plane].w< -radius)return;
    uint level=root.field>>16;
    // Finest READY forest field owns each root, independently of terrain
    // completion. Parent packets remain until replacement bakes are available.
    [loop]for(uint fine=0;fine<level;fine++)
    {float size=_Chart.w*(1u<<fine);int2 key=(int2)floor(root.position.xz/size);if(Present(key.x,key.y,(int)fine))return;}
    _Visible.Append(at);
}
