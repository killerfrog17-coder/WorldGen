#pragma kernel Place
#pragma kernel Cull
StructuredBuffer<float> _Grid;
struct Root { float4 positionForm;float4 colorHeight;float4 shape;float4 normal;float4 grasses;float4 herbs; };
AppendStructuredBuffer<Root> _Roots;
int4 _Candidate;float4 _Tile;uint _Seed;
StructuredBuffer<Root> _PlacedRoots;
ByteAddressBuffer _RootCount;
AppendStructuredBuffer<uint> _NearRoots,_MiddleRoots,_FarRoots;
float4 _CullOrigin,_CullCamera,_CullPlanes[6];float _GrassRange;
uint Mix(uint x){x^=x>>16;x*=0x7feb352du;x^=x>>15;x*=0x846ca68bu;return x^(x>>16);}
float Rand(uint x){return (Mix(x)&0xffffffu)/16777216.;}
float Attribute(int x,int z,int channel){return _Grid[((z*((int)_Tile.w+1)+x)*16)+channel];}
[numthreads(64,1,1)]
void Place(uint3 id:SV_DispatchThreadID)
{
    uint count=_Candidate.z*_Candidate.w;if(id.x>=count)return;
    int2 cell=int2(_Candidate.x+id.x%_Candidate.z,_Candidate.y+id.x/_Candidate.z);
    uint hash=Mix(asuint(cell.x)*73856093u^asuint(cell.y)*19349663u^_Seed);
    // These are adjacent field cells, not independently jittered clump centres.
    // Leaves fill each entire square; ecological cover thins individual leaves.
    float2 p=(float2(cell)+.5)*.60;
    float2 uv=(p-_Tile.xy)/_Tile.z;if(any(uv<0)||any(uv>=1))return;
    float2 q=uv*_Tile.w;int2 a=min((int2)floor(q),(int)_Tile.w-1);float2 f=q-a;
    float values[16];
    [unroll]for(int k=0;k<16;k++)
    {
        float h00=Attribute(a.x,a.y,k),h10=Attribute(a.x+1,a.y,k),h01=Attribute(a.x,a.y+1,k),h11=Attribute(a.x+1,a.y+1,k);
        values[k]=f.x+f.y<=1?h00+(h10-h00)*f.x+(h01-h00)*f.y:h11+(h01-h11)*(1-f.x)+(h10-h11)*(1-f.y);
    }
    float cover=saturate(values[3]);if(cover<.002)return;
    float step=_Tile.z/_Tile.w;
    float sx=f.x+f.y<=1?(Attribute(a.x+1,a.y,15)-Attribute(a.x,a.y,15))/step:(Attribute(a.x+1,a.y+1,15)-Attribute(a.x,a.y+1,15))/step;
    float sz=f.x+f.y<=1?(Attribute(a.x,a.y+1,15)-Attribute(a.x,a.y,15))/step:(Attribute(a.x+1,a.y+1,15)-Attribute(a.x+1,a.y,15))/step;
    Root r;r.positionForm=float4(p.x-_Tile.x,values[15]-.016,p.y-_Tile.y,0);
    // Species, height and cover are selected per leaf, not once for a whole tuft.
    r.colorHeight=float4(values[0],values[1],values[2],max(.4,values[13]));
    r.shape=float4(max(.4,values[14]),Rand(hash+5),Rand(hash+6),Rand(hash+7));
    r.normal=float4(normalize(float3(-sx,1,-sz)),cover);
    r.grasses=float4(values[4],values[5],values[6],values[7])/max(.00001,cover);
    r.herbs=float4(values[8],values[9],values[10],values[11])/max(.00001,cover);
    _Roots.Append(r);
}

// Only compact root indices are updated per frame. Blade geometry is generated
// at draw time, not stored as millions of CPU plants or submitted off screen.
[numthreads(64,1,1)]
void Cull(uint3 id:SV_DispatchThreadID)
{
    if(id.x>=_RootCount.Load(0))return;
    Root r=_PlacedRoots[id.x];float3 p=r.positionForm.xyz+_CullOrigin.xyz;
    float d=distance(p,_CullCamera.xyz);if(d>=_GrassRange)return;
    float radius=max(1.2,r.colorHeight.w*1.6);
    [unroll]for(int k=0;k<6;k++)if(dot(_CullPlanes[k].xyz,p)+_CullPlanes[k].w < -radius)return;
    float s=_GrassRange/160.;
    if(d<42*s)_NearRoots.Append(id.x);
    if(d>25*s&&d<90*s)_MiddleRoots.Append(id.x);
    if(d>65*s)_FarRoots.Append(id.x);
}
